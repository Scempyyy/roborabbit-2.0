# Roborabbit 2.0 Environment Configuration Template

# Server Port
ROBORABBIT_PORT=7777

# Fast Hybrid LLM Router
FREELLMAPI_URL=http://192.168.1.12:3001/v1
FREELLMAPI_KEY=your_freellmapi_key_here
FREELLMAPI_MODEL=auto

# Optional Cloud API Keys (Gemini, OpenAI, Groq)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Hardware Network Targets
LAPTOP_HOST=main-laptop
LAPTOP_IP=192.168.1.12
LAPTOP_MAC=74:d4:dd:75:45:10

SERVER_IP=192.168.1.23

MOBILE_IP=192.168.1.15
MOBILE_PORT=5555
